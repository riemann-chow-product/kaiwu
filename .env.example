# ---------- 可选：大模型（OpenAI 兼容协议）----------
# 配了就走上游模型生成文案；不配则使用内置的本地语义解析引擎（读 README + 依赖清单 + topics）
# 常见取值：
#   腾讯混元 LKEAP : LLM_BASE_URL=https://api.lkeap.cloud.tencent.com/v1     LLM_MODEL=hunyuan-turbos-latest
#   DeepSeek      : LLM_BASE_URL=https://api.deepseek.com/v1                LLM_MODEL=deepseek-chat
#   通义千问       : LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   OpenAI        : LLM_BASE_URL=https://api.openai.com/v1                  LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 可选：GitHub Token ----------
# 不配也能用，但未认证时 GitHub API 限流为 60 次/小时（一次识别约消耗 3-6 次）
GITHUB_TOKEN=

# ---------- 可选：会话签名密钥 ----------
# 不配会自动生成并写入 data/secret.key
KAIWU_SECRET=

# ---------- 可选：批量导入鉴权（生产环境必填）----------
KAIWU_SEED_TOKEN=
